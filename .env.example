# Persistent database and transcode cache. The defaults are ./data and ./data/cache.
VANTA_DATA_DIR=./data
VANTA_CACHE_DIR=./data/cache

# Set true only when Vanta is served over HTTPS.
VANTA_SECURE_COOKIES=false

# Optional: enrich movies and series with posters, backdrops and summaries.
TMDB_API_KEY=

# Optional transcoding controls.
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp
VANTA_TRANSCODE_PRESET=veryfast
VANTA_TRANSCODE_CRF=21

# Maximum size of each uploaded file in bytes (default: 20 GiB).
VANTA_MAX_UPLOAD_BYTES=21474836480
